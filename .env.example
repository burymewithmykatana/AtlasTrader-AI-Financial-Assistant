APP_NAME=AtlasTrader
APP_ENV=development
APP_VERSION=0.1.0
APP_PORT=8000
LOG_LEVEL=INFO
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

POSTGRES_DB=atlas_trader
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me
# Local Python uses localhost; Compose overrides this inside the application container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL overrides the POSTGRES_* values when set.
# DATABASE_URL=postgresql+asyncpg://atlas:change-me@postgres:5432/atlas_trader

NOBITEX_ENV=testnet
NOBITEX_TESTNET_BASE_URL=
# Reserved for a future authenticated adapter; Phase 1 does not use these environment URLs.
NOBITEX_PRODUCTION_BASE_URL=https://api.nobitex.ir
# Retained from the Phase 0 configuration schema; ignored by the Phase 1 public client.
NOBITEX_TOKEN=
# The only Nobitex URL used in Phase 1; it is credential-free and independent of NOBITEX_ENV.
NOBITEX_PUBLIC_BASE_URL=https://api.nobitex.ir
NOBITEX_PUBLIC_TIMEOUT_SECONDS=15
NOBITEX_PUBLIC_MAX_ATTEMPTS=3
NOBITEX_PUBLIC_BACKOFF_SECONDS=0.5
NOBITEX_USER_AGENT=AtlasTrader/0.1.0
# JSON mapping; unknown assets remain usable and are classified as unknown.
ASSET_CLASSIFICATIONS={"IRT":"fiat","RLS":"fiat","USDT":"stablecoin","USDC":"stablecoin","DAI":"stablecoin","XAUT":"gold_backed","PAXG":"gold_backed"}

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

MAX_POSITION_PCT=0.10
MAX_DAILY_LOSS_PCT=0.01
MAX_OPEN_POSITIONS=3
MAX_SPREAD_BPS=40
COOLDOWN_MINUTES=60
STALE_DATA_SECONDS=90
